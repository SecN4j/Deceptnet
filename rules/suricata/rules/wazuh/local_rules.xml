



<!-- Example -->
<group name="local,syslog,sshd,">

 
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- DeceptNet custom rules: Cowrie honeypot event detection (100100-100103) -->
  <!-- Referenced in: README.md > Wazuh Custom Rule 100101 -->

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">\.+</field>
    <description>Cowrie honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: Successful login - $(username)/$(password)</description>
  </rule>

  <rule id="100102" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: Command executed - $(input)</description>
  </rule>

  <rule id="100103" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.session.connect$</field>
    <description>Cowrie: New session connected</description>
  </rule>
</group>
